# AI Proxy Server Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to Git.

# Server-side secret that the Flutter app must send in the X-API-Key header
PROXY_API_KEY=your-very-strong-random-proxy-api-key-here

# Gemini API key (stored only on the server)
GEMINI_API_KEY=your-gemini-api-key-here

# Groq API key (stored only on the server)
GROQ_API_KEY=your-groq-api-key-here

# Optional: override default models
# GEMINI_MODEL=gemini-1.5-flash
# GROQ_MODEL=llama3-8b-8192

# Rate limiting (requests per second, burst allowance)
# RATE_LIMIT_RPS=1
# RATE_LIMIT_BURST=5

# Flask server port
# PORT=5000
