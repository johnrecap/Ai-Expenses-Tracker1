# ── Node Environment ───────────────────────────────────────────
# Options: development | test | staging | production
NODE_ENV=production

# ── Server ────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8080

# ── Logging ───────────────────────────────────────────────────
# Options: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# ── PostgreSQL ────────────────────────────────────────────────
# Docker Compose auto-constructs this; for standalone runs use:
# DATABASE_URL=postgres://user:password@host:5432/dbname
DATABASE_URL=postgres://ai_expenses:change_me_in_production@localhost:5432/ai_expenses

# ── Docker Compose PostgreSQL vars ────────────────────────────
POSTGRES_USER=ai_expenses
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=ai_expenses
POSTGRES_PORT=5432

# ── Firebase Admin SDK ────────────────────────────────────────
# Obtain these from Firebase Console → Project Settings → Service Accounts
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ── Redis (optional) ──────────────────────────────────────────
REDIS_PORT=6379
