# ── Docker Compose Variables ──────────────────────────────────
# These are used for ${VAR} interpolation in docker-compose.yml.
# The server/.env file is loaded separately by containers at runtime.
# Copy this file to .env (no example suffix) before running docker compose.

POSTGRES_USER=ai_expenses
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=ai_expenses
POSTGRES_PORT=5432
SERVER_PORT=8080
REDIS_PORT=6379
